generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  locationId Int       @id @default(autoincrement()) @map("location_id")
  cityName   String    @map("city_name") @db.VarChar(100)
  country    String    @db.VarChar(100)
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  createdAt  DateTime  @default(now()) @map("created_at")
  listings   Listing[]

  @@index([latitude, longitude], name: "idx_locations_coords")
  @@map("locations")
}

model User {
  userId       Int       @id @default(autoincrement()) @map("user_id")
  firstName    String    @map("first_name") @db.VarChar(50)
  lastName     String    @map("last_name") @db.VarChar(50)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  role         UserRole
  createdAt    DateTime  @default(now()) @map("created_at")
  listings     Listing[]
  bookings     Booking[]
  savedListings SavedListing[]
  messages     ContactMessage[]
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  client
  provider
  moderator
  admin
}

model ServiceCategory {
  categoryId  Int       @id @default(autoincrement()) @map("category_id")
  name        String    @unique @db.VarChar(50)
  slug        String    @unique @db.VarChar(50)
  description String?
  listings    Listing[]
  features    Feature[]

  @@map("service_categories")
}

model Listing {
  listingId       Int             @id @default(autoincrement()) @map("listing_id")
  providerId      Int             @map("provider_id")
  categoryId      Int             @map("category_id")
  locationId      Int             @map("location_id")
  title           String          @db.VarChar(255)
  description     String?
  basePrice       Decimal         @map("base_price") @db.Decimal(10, 2)
  pricingUnit     PricingUnit     @map("pricing_unit")
  isActive        Boolean         @default(true) @map("is_active")
  status          ListingStatus   @default(pending)
  coverImageUrl   String?         @map("cover_image_url")
  contactName     String?         @map("contact_name") @db.VarChar(120)
  contactPhone    String?         @map("contact_phone") @db.VarChar(30)
  contactEmail    String?         @map("contact_email") @db.VarChar(150)
  createdAt       DateTime        @default(now()) @map("created_at")

  provider        User             @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  category        ServiceCategory  @relation(fields: [categoryId], references: [categoryId])
  location        Location         @relation(fields: [locationId], references: [locationId])
  propertyDetails PropertyDetail?
  vehicleDetails  VehicleDetail?
  serviceDetails  ServiceDetail?
  features        ListingFeature[]
  images          ListingImage[]
  availabilitySlots AvailabilitySlot[]
  bookings        Booking[]
  savedBy         SavedListing[]
  messages        ContactMessage[]

  @@index([categoryId, locationId, isActive], name: "idx_listings_category_location")
  @@index([providerId], name: "idx_listings_provider")
  @@index([status], name: "idx_listings_status")
  @@map("listings")
}

enum ListingStatus {
  pending
  approved
  rejected
  archived
}

enum PricingUnit {
  per_night
  per_day
  per_hour
  per_service
}

model ListingImage {
  imageId   Int     @id @default(autoincrement()) @map("image_id")
  listingId Int     @map("listing_id")
  url       String
  alt       String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  listing   Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@map("listing_images")
}

model PropertyDetail {
  listingId     Int     @id @map("listing_id")
  propertyType  String  @map("property_type") @db.VarChar(50)
  bedrooms      Int     @default(1)
  bathrooms     Int     @default(1)
  maxGuests     Int     @default(1) @map("max_guests")
  streetAddress String  @map("street_address") @db.VarChar(255)
  listing       Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@map("property_details")
}

model VehicleDetail {
  listingId    Int          @id @map("listing_id")
  make         String       @db.VarChar(50)
  model        String       @db.VarChar(50)
  year         Int
  transmission Transmission?
  fuelType     FuelType?    @map("fuel_type")
  seats        Int          @default(4)
  listing      Listing      @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@map("vehicle_details")
}

enum Transmission {
  automatic
  manual
}

enum FuelType {
  gasoline
  diesel
  electric
  hybrid
}

model ServiceDetail {
  listingId       Int     @id @map("listing_id")
  durationMinutes Int     @map("duration_minutes")
  isAtHome        Boolean @default(false) @map("is_at_home")
  shopAddress     String? @map("shop_address") @db.VarChar(255)
  listing         Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@map("service_details")
}

model Feature {
  featureId  Int             @id @default(autoincrement()) @map("feature_id")
  categoryId Int             @map("category_id")
  name       String          @db.VarChar(50)
  category   ServiceCategory @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  listings   ListingFeature[]

  @@map("features")
}

model ListingFeature {
  listingId Int     @map("listing_id")
  featureId Int     @map("feature_id")
  listing   Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)

  @@id([listingId, featureId])
  @@map("listing_features")
}

model AvailabilitySlot {
  slotId    Int      @id @default(autoincrement()) @map("slot_id")
  listingId Int      @map("listing_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  listing   Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@index([listingId, startTime, endTime, isBooked], name: "idx_slots_schedule")
  @@map("availability_slots")
}

model Booking {
  bookingId     Int           @id @default(autoincrement()) @map("booking_id")
  clientId      Int           @map("client_id")
  listingId     Int           @map("listing_id")
  startDatetime DateTime      @map("start_datetime")
  endDatetime   DateTime      @map("end_datetime")
  totalPrice    Decimal       @map("total_price") @db.Decimal(10, 2)
  status        BookingStatus @default(pending)
  guestName     String?       @map("guest_name") @db.VarChar(120)
  guestPhone    String?       @map("guest_phone") @db.VarChar(30)
  guestCount    Int           @default(1) @map("guest_count")
  message       String?
  createdAt     DateTime      @default(now()) @map("created_at")

  client  User    @relation(fields: [clientId], references: [userId])
  listing Listing @relation(fields: [listingId], references: [listingId])
  payment Payment?
  review  Review?

  @@index([listingId, startDatetime, endDatetime], name: "idx_bookings_listing_dates")
  @@index([clientId], name: "idx_bookings_client")
  @@map("bookings")
}

enum BookingStatus {
  pending
  confirmed
  declined
  completed
  cancelled
}

model Payment {
  paymentId     Int           @id @default(autoincrement()) @map("payment_id")
  bookingId     Int           @unique @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  commissionFee Decimal       @map("commission_fee") @db.Decimal(10, 2)
  paymentMethod String        @map("payment_method") @db.VarChar(30)
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  transactionDate DateTime    @default(now()) @map("transaction_date")
  booking       Booking       @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)

  @@map("payments")
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

model Review {
  reviewId  Int      @id @default(autoincrement()) @map("review_id")
  bookingId Int      @unique @map("booking_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)

  @@map("reviews")
}

model SavedListing {
  userId    Int      @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

model ContactMessage {
  messageId Int      @id @default(autoincrement()) @map("message_id")
  userId    Int?     @map("user_id")
  listingId Int?     @map("listing_id")
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(180)
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [userId], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [listingId], onDelete: SetNull)

  @@map("contact_messages")
}

model AuditLog {
  auditId    Int      @id @default(autoincrement()) @map("audit_id")
  actorId    Int      @map("actor_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int      @map("entity_id")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [userId])

  @@index([entityType, entityId], name: "idx_audit_entity")
  @@map("audit_logs")
}
