DATABASE_URL=mysql://immoove-admin:Immoove_dev_root_password@db:3306/ImmooveDB
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
REDIS_CONNECT_TIMEOUT_MS=1000
MYSQL_DATABASE=ImmooveDB
MYSQL_USER=immoove-admin
MYSQL_PASSWORD=Immoove_dev_root_password
MYSQL_ROOT_PASSWORD=Immoove_dev_root_password
MYSQL_PORT=53306
PORT=4000
API_REPLICAS=2
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=true
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# For LAN testing, also add this computer's LAN URLs, for example:
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://192.168.1.20:5173,http://192.168.1.20:5174
COOKIE_SECURE=true
PUBLIC_HTTPS=false
# For trusted local-network testing over HTTP only, set COOKIE_SECURE=false.
# Never disable secure cookies on a public or untrusted network.
# When production HTTPS is enabled, set PUBLIC_HTTPS=true; startup then enforces COOKIE_SECURE=true.
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW_MS=900000
DISABLE_RATE_LIMITS=false
REQUEST_BODY_LIMIT_BYTES=102400
# Reserved for the future official WhatsApp Business provider. Keep disabled until
# the sender is verified, a utility template is approved, and credentials are installed.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_SENDER=+2126********
WHATSAPP_TEMPLATE_NAME=booking_request_received
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_WINDOW_MS=900000
PROFILE_CHANGE_RATE_LIMIT_MAX=5
PROFILE_CHANGE_RATE_LIMIT_WINDOW_MS=3600000
